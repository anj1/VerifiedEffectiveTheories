    linarith
  have row0 : (67 / 1 : ℝ) * f.vacuumH 0 + (-64 / 1 : ℝ) * f.vacuumH 1 = 0 := by
    rw [ve 0 (by norm_num)] at hv0
    norm_num at hv0
    linarith
  have row1 : (-64 / 1 : ℝ) * f.vacuumH 0 + (131 / 1 : ℝ) * f.vacuumH 1 + (-64 / 1 : ℝ) * f.vacuumH 2 = 0 := by
