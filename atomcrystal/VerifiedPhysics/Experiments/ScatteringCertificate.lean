    linarith
  have ve (j : ℕ) (hj : j < 15) : f.vacuumE j = 8*(f.vacuumH (j+1)-f.vacuumH j) := (ht j hj).1
  have me (j : ℕ) (hj : j < 15) : f.materialE j = (-4 / 1 : ℝ) * (f.materialH (j+1)-f.materialH j) := by
    obtain ⟨_, h1, h2⟩ := ht j hj
