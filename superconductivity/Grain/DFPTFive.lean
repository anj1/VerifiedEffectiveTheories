abbrev Index := Fin 2 × Fin 3

def oddElectrons : ℕ := 5
def activeOrbitals : ℕ := 3
def energyResolution : ℚ := 1/10000000000000

def caseWeight : Fin 2 → ℚ := ![1, (-1)]
def weight (a : Index) : ℚ := caseWeight a.1 * (![-1/2, 1, -1/2] : Fin 3 → ℚ) a.2

theorem export_parameters :
    oddElectrons % 2 = 1 ∧ 0 < energyResolution ∧
    (∀ i : Fin 2, oddElectrons < 2 * (![5, 5] : Fin 2 → ℕ) i ∧
      0 < activeOrbitals ∧ activeOrbitals ≤ (![5, 5] : Fin 2 → ℕ) i) ∧
    (∑ i, caseWeight i) = 0 := by decide +kernel

noncomputable def electronicEnergy (a : Index) : ℝ := (![![electronicGround Case0.input 4, electronicGround Case0.input 5, electronicGround Case0.input 6], ![electronicGround Case1.input 4, electronicGround Case1.input 5, electronicGround Case1.input 6]] a.1) a.2

private def electronicLo (a : Index) : ℚ := (![![Case0.w4.lower, Case0.w5.lower, Case0.w6.lower], ![Case1.w4.lower, Case1.w5.lower, Case1.w6.lower]] a.1) a.2
